{
  "manifest_version": 3,
  "name": "Tabstead probe",
  "version": "0.0.1",
  "permissions": [
    "tabs",
    "tabHide",
    "tabGroups",
    "sessions",
    "storage"
  ],
  "background": {
    "scripts": [
      "bg.js",
      "bg2.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tabstead-probe@lagudafuadtosin",
      "strict_min_version": "139.0"
    }
  }
}